<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nachi Eng AI Assistant</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --nachi-dark: #0a0e1a;
    --nachi-navy: #0d1526;
    --nachi-blue: #1a6bff;
    --nachi-blue-bright: #3d8bff;
    --nachi-cyan: #00d4ff;
    --nachi-text: #e8edf8;
    --nachi-muted: #6b7a99;
    --nachi-border: rgba(26, 107, 255, 0.2);
    --nachi-glass: rgba(13, 21, 38, 0.95);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: #f0f4f8;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 20px;
  }

  /* ── CHAT BUBBLE TRIGGER ── */
  #chat-trigger {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 62px;
    height: 62px;
    background: linear-gradient(135deg, var(--nachi-blue), var(--nachi-cyan));
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 24px rgba(26,107,255,0.5), 0 0 0 0 rgba(26,107,255,0.3);
    animation: pulse-ring 2.5s ease infinite;
    z-index: 9999;
    transition: transform 0.2s;
  }
  #chat-trigger:hover { transform: scale(1.08); }
  #chat-trigger svg { width: 28px; height: 28px; fill: #fff; }
  #chat-trigger .close-icon { display: none; }
  #chat-trigger.open .chat-icon { display: none; }
  #chat-trigger.open .close-icon { display: block; }

  @keyframes pulse-ring {
    0%   { box-shadow: 0 4px 24px rgba(26,107,255,0.5), 0 0 0 0 rgba(26,107,255,0.3); }
    70%  { box-shadow: 0 4px 24px rgba(26,107,255,0.5), 0 0 0 14px rgba(26,107,255,0); }
    100% { box-shadow: 0 4px 24px rgba(26,107,255,0.5), 0 0 0 0 rgba(26,107,255,0); }
  }

  /* ── CHAT WINDOW ── */
  #chat-window {
    position: fixed;
    bottom: 104px;
    right: 28px;
    width: 380px;
    max-width: calc(100vw - 40px);
    height: 580px;
    max-height: calc(100vh - 130px);
    background: var(--nachi-dark);
    border-radius: 20px;
    border: 1px solid var(--nachi-border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(26,107,255,0.1);
    z-index: 9998;
    transform: translateY(20px) scale(0.95);
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  #chat-window.open {
    transform: translateY(0) scale(1);
    opacity: 1;
    pointer-events: all;
  }

  /* ── HEADER ── */
  .chat-header {
    background: linear-gradient(135deg, #0d1526 0%, #0a1a3a 100%);
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--nachi-border);
    flex-shrink: 0;
  }
  .header-logo {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--nachi-blue), var(--nachi-cyan));
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: #fff;
    letter-spacing: 0.5px;
    flex-shrink: 0;
  }
  .header-info { flex: 1; }
  .header-name {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--nachi-text);
    letter-spacing: 0.5px;
  }
  .header-status {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: #00e676;
    margin-top: 1px;
  }
  .status-dot {
    width: 6px; height: 6px;
    background: #00e676;
    border-radius: 50%;
    animation: blink 1.8s ease infinite;
  }
  @keyframes blink {
    0%,100% { opacity: 1; } 50% { opacity: 0.3; }
  }

  /* ── SCREENS ── */
  .screen {
    flex: 1;
    display: none;
    flex-direction: column;
    overflow: hidden;
  }
  .screen.active { display: flex; }

  /* ── WELCOME SCREEN ── */
  #screen-welcome {
    padding: 24px 20px;
    overflow-y: auto;
  }
  .welcome-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(26,107,255,0.12);
    border: 1px solid rgba(26,107,255,0.3);
    border-radius: 20px;
    padding: 4px 12px;
    font-size: 11px;
    color: var(--nachi-cyan);
    font-weight: 500;
    margin-bottom: 16px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .welcome-title {
    font-family: 'Rajdhani', sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--nachi-text);
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .welcome-title span {
    background: linear-gradient(90deg, var(--nachi-blue), var(--nachi-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .welcome-sub {
    font-size: 13px;
    color: var(--nachi-muted);
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .form-group { margin-bottom: 14px; }
  .form-label {
    display: block;
    font-size: 11px;
    font-weight: 500;
    color: var(--nachi-muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 6px;
  }
  .form-input {
    width: 100%;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--nachi-border);
    border-radius: 10px;
    padding: 11px 14px;
    color: var(--nachi-text);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .form-input::placeholder { color: var(--nachi-muted); }
  .form-input:focus {
    border-color: var(--nachi-blue);
    background: rgba(26,107,255,0.07);
  }

  /* ── SECTOR GRID ── */
  .sector-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--nachi-muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 8px;
    display: block;
  }
  .sector-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 18px;
  }
  .sector-btn {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--nachi-border);
    border-radius: 10px;
    padding: 10px 8px;
    color: var(--nachi-muted);
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
    line-height: 1.3;
  }
  .sector-btn:hover {
    border-color: var(--nachi-blue);
    color: var(--nachi-text);
    background: rgba(26,107,255,0.1);
  }
  .sector-btn.selected {
    border-color: var(--nachi-cyan);
    background: rgba(0,212,255,0.1);
    color: var(--nachi-cyan);
  }
  .sector-btn .sector-icon { font-size: 18px; display: block; margin-bottom: 4px; }

  .start-btn {
    width: 100%;
    padding: 14px;
    background: linear-gradient(135deg, var(--nachi-blue), var(--nachi-cyan));
    border: none;
    border-radius: 12px;
    color: #fff;
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1px;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
    text-transform: uppercase;
  }
  .start-btn:hover { opacity: 0.9; transform: translateY(-1px); }
  .start-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

  /* ── CHAT SCREEN ── */
  #screen-chat { display: none; flex-direction: column; }
  #screen-chat.active { display: flex; }

  .sector-tag {
    margin: 10px 16px 0;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(0,212,255,0.1);
    border: 1px solid rgba(0,212,255,0.25);
    border-radius: 20px;
    padding: 4px 10px;
    font-size: 11px;
    color: var(--nachi-cyan);
    align-self: flex-start;
    flex-shrink: 0;
  }

  .messages-area {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    scrollbar-width: thin;
    scrollbar-color: rgba(26,107,255,0.3) transparent;
  }

  .msg {
    max-width: 88%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 13px;
    line-height: 1.55;
    animation: fadeUp 0.3s ease;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .msg.bot {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--nachi-text);
    border-radius: 4px 14px 14px 14px;
    align-self: flex-start;
  }
  .msg.user {
    background: linear-gradient(135deg, var(--nachi-blue), #1256cc);
    color: #fff;
    border-radius: 14px 4px 14px 14px;
    align-self: flex-end;
  }
  .msg.bot strong { color: var(--nachi-cyan); }

  .typing-indicator {
    display: flex;
    gap: 4px;
    padding: 12px 16px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 4px 14px 14px 14px;
    align-self: flex-start;
    width: fit-content;
    animation: fadeUp 0.3s ease;
  }
  .typing-indicator span {
    width: 6px; height: 6px;
    background: var(--nachi-muted);
    border-radius: 50%;
    animation: bounce 1.2s ease infinite;
  }
  .typing-indicator span:nth-child(2) { animation-delay: 0.15s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes bounce {
    0%,60%,100% { transform: translateY(0); }
    30% { transform: translateY(-5px); }
  }

  .calendly-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, var(--nachi-blue), var(--nachi-cyan));
    color: #fff;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    margin-top: 8px;
    transition: opacity 0.2s;
  }
  .calendly-btn:hover { opacity: 0.85; }

  /* ── INPUT AREA ── */
  .input-area {
    padding: 12px 14px;
    border-top: 1px solid var(--nachi-border);
    display: flex;
    gap: 8px;
    align-items: flex-end;
    flex-shrink: 0;
    background: rgba(255,255,255,0.02);
  }
  .chat-input {
    flex: 1;
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--nachi-border);
    border-radius: 10px;
    padding: 10px 14px;
    color: var(--nachi-text);
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    outline: none;
    resize: none;
    max-height: 80px;
    transition: border-color 0.2s;
    line-height: 1.4;
  }
  .chat-input::placeholder { color: var(--nachi-muted); }
  .chat-input:focus { border-color: var(--nachi-blue); }

  .send-btn {
    width: 38px; height: 38px;
    background: linear-gradient(135deg, var(--nachi-blue), var(--nachi-cyan));
    border: none;
    border-radius: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: opacity 0.2s, transform 0.2s;
  }
  .send-btn:hover { opacity: 0.85; transform: scale(1.05); }
  .send-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
  .send-btn svg { width: 16px; height: 16px; fill: #fff; }

  .powered-by {
    text-align: center;
    padding: 6px;
    font-size: 10px;
    color: rgba(107,122,153,0.6);
    flex-shrink: 0;
  }
  .powered-by a { color: rgba(107,122,153,0.6); text-decoration: none; }

  /* ── ERROR STATE ── */
  .error-msg {
    background: rgba(255,50,50,0.1);
    border: 1px solid rgba(255,50,50,0.2);
    color: #ff6b6b;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12px;
    margin: 0 16px 8px;
    flex-shrink: 0;
    display: none;
  }

  /* Scrollbar */
  .messages-area::-webkit-scrollbar { width: 4px; }
  .messages-area::-webkit-scrollbar-track { background: transparent; }
  .messages-area::-webkit-scrollbar-thumb { background: rgba(26,107,255,0.3); border-radius: 2px; }
</style>
</head>
<body>

<!-- TRIGGER BUTTON -->
<button id="chat-trigger" onclick="toggleChat()">
  <svg class="chat-icon" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 10H6V10h12v2zm0-3H6V7h12v2z"/></svg>
  <svg class="close-icon" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
</button>

<!-- CHAT WINDOW -->
<div id="chat-window">

  <!-- HEADER -->
  <div class="chat-header">
    <div class="header-logo">NE</div>
    <div class="header-info">
      <div class="header-name">NACHI ENG AI ASSISTANT</div>
      <div class="header-status"><span class="status-dot"></span> Online — Ready to Help</div>
    </div>
  </div>

  <!-- SCREEN 1: WELCOME + LEAD CAPTURE -->
  <div id="screen-welcome" class="screen active">
    <div class="welcome-badge">⚡ AI-Powered</div>
    <div class="welcome-title">Smarter Maintenance.<br><span>Zero Downtime.</span></div>
    <div class="welcome-sub">Get instant answers about CMMS and how Nachi Eng can transform your maintenance operations. Tell us a bit about yourself first.</div>

    <div class="form-group">
      <label class="form-label">Your Name</label>
      <input class="form-input" id="input-name" type="text" placeholder="e.g. Andrew Carter" />
    </div>
    <div class="form-group">
      <label class="form-label">Company</label>
      <input class="form-input" id="input-company" type="text" placeholder="e.g. NHS South East Coast" />
    </div>
    <div class="form-group">
      <label class="form-label">Work Email</label>
      <input class="form-input" id="input-email" type="email" placeholder="e.g. andrew@company.co.uk" />
    </div>

    <span class="sector-label">Your Sector</span>
    <div class="sector-grid">
      <button class="sector-btn" onclick="selectSector(this, 'NHS / Healthcare')">
        <span class="sector-icon">🏥</span>NHS / Healthcare
      </button>
      <button class="sector-btn" onclick="selectSector(this, 'Hotels / Hospitality')">
        <span class="sector-icon">🏨</span>Hotels / Hospitality
      </button>
      <button class="sector-btn" onclick="selectSector(this, 'Manufacturing / Industrial')">
        <span class="sector-icon">🏭</span>Manufacturing / Industrial
      </button>
      <button class="sector-btn" onclick="selectSector(this, 'Property / Real Estate')">
        <span class="sector-icon">🏢</span>Property / Real Estate
      </button>
      <button class="sector-btn" onclick="selectSector(this, 'Logistics / Transport')">
        <span class="sector-icon">🚛</span>Logistics / Transport
      </button>
      <button class="sector-btn" onclick="selectSector(this, 'Other')">
        <span class="sector-icon">🔧</span>Other
      </button>
    </div>

    <button class="start-btn" id="start-btn" onclick="startChat()" disabled>
      START CONVERSATION →
    </button>
  </div>

  <!-- SCREEN 2: CHAT -->
  <div id="screen-chat" class="screen">
    <div class="sector-tag" id="sector-tag">🏥 NHS / Healthcare</div>
    <div class="messages-area" id="messages-area"></div>
    <div class="error-msg" id="error-msg">Connection issue — please try again.</div>
    <div class="input-area">
      <textarea class="chat-input" id="chat-input" placeholder="Ask about CMMS, our services, pricing..." rows="1"
        onkeydown="handleKey(event)" oninput="autoResize(this)"></textarea>
      <button class="send-btn" id="send-btn" onclick="sendMessage()">
        <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
      </button>
    </div>
    <div class="powered-by">Powered by <a href="https://nachieng.co.uk" target="_blank">Nachi Eng Ltd</a></div>
  </div>

</div>

<script>
  let isOpen = false;
  let selectedSector = '';
  let conversationHistory = [];
  let leadData = {};
  let isLoading = false;

  // ── TOGGLE CHAT ──
  function toggleChat() {
    isOpen = !isOpen;
    document.getElementById('chat-window').classList.toggle('open', isOpen);
    document.getElementById('chat-trigger').classList.toggle('open', isOpen);
  }

  // ── SECTOR SELECTION ──
  function selectSector(btn, sector) {
    document.querySelectorAll('.sector-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    selectedSector = sector;
    validateForm();
  }

  // ── FORM VALIDATION ──
  function validateForm() {
    const name = document.getElementById('input-name').value.trim();
    const email = document.getElementById('input-email').value.trim();
    const company = document.getElementById('input-company').value.trim();
    const valid = name && email && company && selectedSector && email.includes('@');
    document.getElementById('start-btn').disabled = !valid;
  }

  ['input-name','input-email','input-company'].forEach(id => {
    document.getElementById(id).addEventListener('input', validateForm);
  });

  // ── START CHAT ──
  function startChat() {
    leadData = {
      name: document.getElementById('input-name').value.trim(),
      company: document.getElementById('input-company').value.trim(),
      email: document.getElementById('input-email').value.trim(),
      sector: selectedSector
    };

    document.getElementById('screen-welcome').classList.remove('active');
    document.getElementById('screen-chat').classList.add('active');
    document.getElementById('sector-tag').textContent = getSectorEmoji(selectedSector) + ' ' + selectedSector;

    const greeting = `Hi ${leadData.name}! 👋 Great to connect. I'm the Nachi Eng AI assistant — here to help you understand how a CMMS can transform maintenance operations at **${leadData.company}**.

I can see you're in the **${selectedSector}** sector — that's a key area where we work. What would you like to know? You can ask me anything about CMMS, our services, or how we've helped teams like yours.`;

    addBotMessage(greeting);

    conversationHistory.push({
      role: 'user',
      content: `My name is ${leadData.name}, I work at ${leadData.company} (${leadData.email}), in the ${selectedSector} sector. Please greet me and start helping me understand CMMS and Nachi Eng's services.`
    });
    conversationHistory.push({
      role: 'assistant',
      content: greeting
    });

    setTimeout(() => document.getElementById('chat-input').focus(), 300);
  }

  function getSectorEmoji(sector) {
    const map = {
      'NHS / Healthcare': '🏥',
      'Hotels / Hospitality': '🏨',
      'Manufacturing / Industrial': '🏭',
      'Property / Real Estate': '🏢',
      'Logistics / Transport': '🚛',
      'Other': '🔧'
    };
    return map[sector] || '🔧';
  }

  // ── SEND MESSAGE ──
  async function sendMessage() {
    const input = document.getElementById('chat-input');
    const text = input.value.trim();
    if (!text || isLoading) return;

    input.value = '';
    input.style.height = 'auto';
    addUserMessage(text);
    conversationHistory.push({ role: 'user', content: text });

    setLoading(true);
    hideError();

    const systemPrompt = `You are the AI assistant for Nachi Eng Ltd, a UK-based Maintenance Management Systems consultancy. You are helpful, professional, and knowledgeable.

ABOUT NACHI ENG:
- Company: Nachi Eng Ltd (Company No. 16567818)
- Founder & Director: Godswill Iweajunwa — BEng (Hons) First Class, MIET, 18th Edition qualified
- Services: CMMS implementation, maintenance management consultancy, asset management systems
- Website: nachieng.co.uk
- Book a call: calendly.com/godswill-nachieng/30min
- Email: info@nachieng.co.uk
- Based: Southend-on-Sea, UK. Serving all UK operations
- Tagline: "Smarter Maintenance. Zero Downtime."
- Stats: 24/7 Support, 6+ Industries, 99% Satisfaction

CURRENT VISITOR:
- Name: ${leadData.name}
- Company: ${leadData.company}
- Sector: ${leadData.sector}

WHAT IS CMMS:
A Computerised Maintenance Management System (CMMS) is software that centralises maintenance information and helps operations teams manage assets, schedule preventive maintenance, track work orders, manage spare parts inventory, and ensure compliance. It converts reactive (breakdown) maintenance into planned, preventive maintenance — reducing downtime and costs.

SECTOR-SPECIFIC KNOWLEDGE:
- NHS/Healthcare: Asset lifecycle management, HTM compliance, PPM scheduling for critical medical equipment, CQC compliance
- Hotels/Hospitality: Guest experience protection, multi-site asset tracking, reactive vs planned maintenance balance, cost reduction
- Manufacturing/Industrial: OEE improvement, production line uptime, ISO 55001 asset management, shift-based scheduling
- Property/Real Estate: Portfolio-wide asset visibility, compliance tracking, energy management integration, contractor management
- Logistics/Transport: Fleet maintenance scheduling, HGV compliance, depot management, regulatory compliance

PRICING:
Never give exact prices. Always say: "Every project is scoped to your specific operation. The best step is a free 30-minute discovery call with Godswill where he can understand your setup and give you a tailored proposal." Then provide the Calendly link.

RESPONSE STYLE:
- Conversational, helpful, never salesy
- Keep responses concise (3-5 sentences max unless detail is needed)
- Use **bold** for key terms
- Always guide toward booking a discovery call
- If they ask to book a call, provide: calendly.com/godswill-nachieng/30min
- Never make up case studies or specific client names
- If you don't know something, say "That's a great question for Godswill on a call — he can give you a specific answer"`;

    try {
      const response = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: 'claude-sonnet-4-20250514',
          max_tokens: 1000,
          system: systemPrompt,
          messages: conversationHistory
        })
      });

      if (!response.ok) throw new Error('API error');
      const data = await response.json();
      const reply = data.content[0].text;

      conversationHistory.push({ role: 'assistant', content: reply });
      removeTyping();
      addBotMessage(reply);

      // Show Calendly button if booking intent detected
      const bookingKeywords = ['book', 'call', 'calendly', 'schedule', 'meeting', 'speak', 'chat', 'demo'];
      if (bookingKeywords.some(k => (text + reply).toLowerCase().includes(k))) {
        addCalendlyButton();
      }

    } catch (err) {
      removeTyping();
      showError();
    } finally {
      setLoading(false);
    }
  }

  // ── UI HELPERS ──
  function addUserMessage(text) {
    const area = document.getElementById('messages-area');
    const div = document.createElement('div');
    div.className = 'msg user';
    div.textContent = text;
    area.appendChild(div);
    scrollToBottom();
  }

  function addBotMessage(text) {
    const area = document.getElementById('messages-area');
    const div = document.createElement('div');
    div.className = 'msg bot';
    div.innerHTML = formatMessage(text);
    area.appendChild(div);
    scrollToBottom();
  }

  function formatMessage(text) {
    return text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n\n/g, '<br><br>')
      .replace(/\n/g, '<br>');
  }

  function addCalendlyButton() {
    const area = document.getElementById('messages-area');
    const existing = area.querySelector('.calendly-btn');
    if (existing) return;
    const a = document.createElement('a');
    a.className = 'calendly-btn';
    a.href = 'https://calendly.com/godswill-nachieng/30min';
    a.target = '_blank';
    a.innerHTML = '📅 Book a Free 30-Min Call';
    area.appendChild(a);
    scrollToBottom();
  }

  function addTyping() {
    const area = document.getElementById('messages-area');
    const div = document.createElement('div');
    div.className = 'typing-indicator';
    div.id = 'typing';
    div.innerHTML = '<span></span><span></span><span></span>';
    area.appendChild(div);
    scrollToBottom();
  }

  function removeTyping() {
    const t = document.getElementById('typing');
    if (t) t.remove();
  }

  function setLoading(state) {
    isLoading = state;
    document.getElementById('send-btn').disabled = state;
    document.getElementById('chat-input').disabled = state;
    if (state) addTyping();
  }

  function showError() {
    document.getElementById('error-msg').style.display = 'block';
  }

  function hideError() {
    document.getElementById('error-msg').style.display = 'none';
  }

  function scrollToBottom() {
    const area = document.getElementById('messages-area');
    area.scrollTop = area.scrollHeight;
  }

  function handleKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  }

  function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 80) + 'px';
  }
</script>
</body>
</html>
